# Chronicle Backend — Environment Variables
# Copy to .env and adjust for your environment

# --- Database ---
DATABASE_URL=postgresql+asyncpg://chronicle:chronicle@localhost:5433/chronicle

# Sync URL used by Alembic (migrations run synchronously)
DATABASE_URL_SYNC=postgresql+psycopg2://chronicle:chronicle@localhost:5433/chronicle

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=chronicle_meili_master_key

# --- App settings ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: Redis (for tile caching in production) ---
# REDIS_URL=redis://localhost:6379

# --- Optional: AI pipeline ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Admin API ---
# Required for /api/admin/* (disabled when unset or shorter than 24 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=
# Anonymous event submissions allowed per client per hour (in memory, per worker)
SUBMIT_RATE_LIMIT_PER_HOUR=10
